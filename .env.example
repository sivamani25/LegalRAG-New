# Environment variables for LegalRAG
#
# Copy this file to .env and fill in values. The .env file is gitignored and
# must never be committed. All variables are optional at startup; they are read
# at the time the relevant component is first called.

# ---------------------------------------------------------------------------
# Generation (Milestone 5)
# ---------------------------------------------------------------------------

# Required when generation.provider = openrouter
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Ollama (optional — only needed when generation.provider = ollama)
# ---------------------------------------------------------------------------

# Base URL for a locally running Ollama instance.
# Default: http://localhost:11434
OLLAMA_BASE_URL=
